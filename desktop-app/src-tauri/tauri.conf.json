{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mineserver",
  "version": "0.1.0",
  "identifier": "ai.mineserver.desktop",
  "build": {
    "beforeDevCommand": "node scripts/copy-web.mjs",
    "beforeBuildCommand": "node scripts/copy-web.mjs",
    "frontendDist": "../web",
    "devUrl": "http://127.0.0.1:8080"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mineserver",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/mineserver"
    ]
  }
}
