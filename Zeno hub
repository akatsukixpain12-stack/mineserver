-- CORE FARM LOOP (Go to NPC + Kill Fast)
-- =============================================
local farmConn
local function startFarm()
    if farmConn then farmConn:Disconnect() end
    farmConn = RunService.Heartbeat:Connect(function()
        if not farmEnabled then return end

        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root then 
            status.Text = "Status: Waiting for respawn..."
            return 
        end

        -- Find closest enemy
        local closest, minDist = nil, math.huge
        for _, npc in ipairs(Workspace.Enemies:GetChildren()) do
            if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                local dist = (root.Position - npc.HumanoidRootPart.Position).Magnitude
                if dist < minDist and dist < 900 then
                    minDist = dist
                    closest = npc
                end
            end
        end

        if closest then
            status.Text = "Killing: " .. closest.Name .. " (" .. math.floor(minDist) .. " studs)"

            -- Move to NPC
            local targetPos = closest.HumanoidRootPart.CFrame * CFrame.new(0, 0, 5)
            TweenService:Create(root, TweenInfo.new(0.25, Enum.EasingStyle.Linear), {CFrame = targetPos}):Play()

            -- Auto Equip Melee
            local tool = player.Character:FindFirstChildOfClass("Tool")
            if not tool then
                for _, t in ipairs(player.Backpack:GetChildren()) do
                    if t:IsA("Tool") then
                        player.Character.Humanoid:EquipTool(t)
                        break
                    end
                end
            end

            -- Ultra Fast Attack
            tool = player.Character:FindFirstChildOfClass("Tool")
            if tool then
                for _ = 1, 6 do
                    tool:Activate()
                end
            end
        else
            status.Text = "Status: Searching for NPCs..."
        end
    end)
end

