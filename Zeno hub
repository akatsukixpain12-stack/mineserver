-- CORE FARMING LOGIC (Optimized, No Lag)
-- =============================================
local farmEnabled = false
local autoFarmConn

local function getClosestEnemy()
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local closest, dist = nil, math.huge
    for _, e in ipairs(Workspace.Enemies:GetChildren()) do
        if e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
            local d = (root.Position - e.HumanoidRootPart.Position).Magnitude
            if d < dist and d < 1200 then
                dist = d
                closest = e
            end
        end
    end
    return closest
end

local function startAutoFarm()
    if autoFarmConn then autoFarmConn:Disconnect() end
    autoFarmConn = RunService.Heartbeat:Connect(function()
        if not farmEnabled then return end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local enemy = getClosestEnemy()
        if enemy then
            local target = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 0, 6)
            TweenService:Create(root, TweenInfo.new(0.25), {CFrame = target}):Play()

            local tool = player.Character:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
            if tool then
                if not player.Character:FindFirstChildOfClass("Tool") then
                    player.Character.Humanoid:EquipTool(tool)
                end
                tool:Activate()
            end
        end
    end)
end

